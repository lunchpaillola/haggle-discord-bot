# Copy to .env and fill in your Discord app credentials.
# Do NOT commit real tokens.

DISCORD_BOT_TOKEN=
CLIENT_ID=
# HAGGLE AI server (right-click server → Copy Server ID with Developer Mode on)
GUILD_ID=1553372098943262750

# Optional: pin listings to a specific channel (snowflake ID).
# If unset, the bot resolves by name (prefer exact "marketplace", then for-sale / for_sale)
# and caches the id. Missing channel: creates #marketplace if bot has Manage Channels.
MARKETPLACE_CHANNEL_ID=
# Optional: wanted posts. If unset, uses a channel named "wanted", else marketplace.
WANTED_CHANNEL_ID=

# Optional: persistent local negotiation state (default: ./data/negotiations.json)
# NEGOTIATION_STATE_PATH=./data/negotiations.json

# Set to 0 to disable Message Content Intent (slash commands only)
# ENABLE_MESSAGE_CONTENT=1
